# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Frontend origin(s) allowed by CORS. Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:5173

# Public web app origin used to build invite links.
PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://blink_user:blink_pass@localhost:5432/blink_db

# ---------------------------------------------------------------------------
# Redis 7 (optional: rate limiting falls back to in-memory if unreachable)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT (each secret MUST be at least 64 random characters, unique per env)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-64-char-random-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=replace-me-with-a-64-char-random-refresh-secret-0123456789abcdef
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bcrypt work factor (12 is the product requirement)
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Uploads — photos are ephemeral and deleted with their message
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=2097152

# ---------------------------------------------------------------------------
# Expiration / jobs
# ---------------------------------------------------------------------------
MESSAGE_CLEANUP_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Observability & safety switches
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Set to false only in automated tests; never in production.
RATE_LIMIT_ENABLED=true
